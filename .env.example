POSTGRES_USER=physiodesk
POSTGRES_PASSWORD=physiodesk
POSTGRES_DB=physiodesk
POSTGRES_PORT=5432

# Host ports for the API and the web app (used by docker-compose).
API_PORT=8000
WEB_PORT=3000

# --- Backend ---
DATABASE_URL=postgresql+psycopg://physiodesk:physiodesk@localhost:5432/physiodesk

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

CORS_ORIGINS=http://localhost:3000

SEED_ADMIN_USERNAME=frontdesk
SEED_ADMIN_PASSWORD=physiodesk123

# Set false to start the API container against an empty database.
SEED_ON_START=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
